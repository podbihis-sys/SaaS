# --- BIT-Website (self-hosted, MariaDB) ---
# MariaDB-Zugang (Fallback auf DB_* ist moeglich).
BIT_DB_HOST=127.0.0.1
BIT_DB_PORT=3306
BIT_DB_USER=
BIT_DB_PASSWORD=
BIT_DB_NAME=

# Secret fuer die Admin-Session (jose/JWT). Lang und zufaellig waehlen,
# z. B.: openssl rand -base64 48
BIT_AUTH_SECRET=

# Verzeichnis fuer hochgeladene Bilder (Produkte/News/Kategorien).
BIT_UPLOAD_DIR=/var/www/vhosts/example.com/bit-uploads

# --- Nur fuer die einmalige Migration (migrate-supabase-to-mariadb.mjs) ---
NEXT_PUBLIC_BIT_SUPABASE_URL=
NEXT_PUBLIC_BIT_SUPABASE_ANON_KEY=

# --- SaaS-App (nicht BIT) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
