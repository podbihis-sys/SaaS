# Public URL of the deployed site (used for SEO: canonical, sitemap, hreflang)
NEXT_PUBLIC_SITE_URL=https://adriawebcode.com

# --- E-Mail (optional, empfohlen) ---
# API-Key von https://resend.com – ohne Key funktioniert alles,
# aber Angebote werden nur auf dem Bildschirm angezeigt (kein E-Mail-Versand).
RESEND_API_KEY=
# Absenderadresse (muss bei Resend verifiziert sein)
MAIL_FROM=adriawebcode <angebot@adriawebcode.com>
# Wohin neue Lead-Benachrichtigungen gehen
LEAD_NOTIFY_EMAIL=podbihis@gmail.com
