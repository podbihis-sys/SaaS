# Copy to .env. Values here are development defaults.

ENV=dev
LOG_LEVEL=INFO

# Postgres via ../docker-compose.yml, or sqlite+aiosqlite:///./dev.db for a
# zero-dependency local run.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/termine
TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:

# Signs the long-lived device tokens. MUST be replaced outside development.
JWT_SECRET=change-me-to-a-long-random-string-32-plus
JWT_TTL_DAYS=365

CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# --- Scanner ---------------------------------------------------------------
# `demo` is synthetic and contacts no real authority. Enabling a real adapter
# is a deliberate act: read ../docs/legal.md first.
SCANNER_ENABLED=true
SCANNER_PROVIDERS=demo
SCANNER_MIN_INTERVAL_SECONDS=120
SCANNER_TICK_SECONDS=30
SCANNER_HORIZON_DAYS=90
SCANNER_FAILURE_THRESHOLD=5
SCANNER_COOLDOWN_SECONDS=1800

# Sent on every outbound request. Keep it honest and contactable.
HTTP_USER_AGENT=TerminRadar/0.1 (+https://example.org/terminradar; appointment availability monitor)
HTTP_TIMEOUT_SECONDS=15

# --- Notifications ---------------------------------------------------------
# false logs pushes instead of sending them; useful in development.
PUSH_ENABLED=true
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
# Only needed if the Expo project enforces push security.
EXPO_ACCESS_TOKEN=
NOTIFY_MAX_PER_HOUR=12
